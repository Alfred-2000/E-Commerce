				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Get the response headers",
									"const headers = pm.response.headers;",
									"",
									"console.log(\"before Authorization Env :\",  pm.collectionVariables.get('authToken'));",
									"",
									"// Loop through the headers and print each one",
									"headers.each((eachHeader, key) => {",
									"    // console.log(eachHeader)",
									"    if(eachHeader && eachHeader.key && eachHeader.key === 'Authorization') {",
									"        console.log(eachHeader)",
									"        pm.collectionVariables.set(\"authToken\", eachHeader.value);",
									"    }",
									"});",
									"",
									"console.log(\"after Authorization Env :\",  pm.collectionVariables.get('authToken'));",
									"",
									"let response = pm.response.json();",
									"pm.collectionVariables.set(\"user_id\", response.user_id);",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var username = pm.collectionVariables.get(\"username\");",
									"var password = pm.collectionVariables.get(\"password\");",
									"",
									"var username = \"Super-Admin\";",
									"var password = \"Ecommerce@!123\";",
									"",
									"const userCreds = {",
									"    \"username\": username,",
									"    \"password\": password",
									"};",
									"",
									"pm.environment.set(\"userCreds\", JSON.stringify(userCreds));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
